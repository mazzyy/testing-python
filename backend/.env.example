# Application Settings
APP_NAME="DAAD Course Recommendation System"
APP_VERSION="1.0.0"
DEBUG=False
FRONTEND_URL="http://localhost:3000"

# Database
# For SQLite:
# DATABASE_URL="sqlite:///./daad_app.db"
# For PostgreSQL:
DATABASE_URL="postgresql://uniadvisor:uniadvisor_password@db:5432/uniadvisor_db"

# JWT Authentication
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY="replace-with-secure-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Azure OpenAI Configuration (Chat/Completions)
AZURE_OPENAI_ENDPOINT="https://veilixdocumentextraction.openai.azure.com/"
AZURE_OPENAI_API_KEY="replace-with-your-api-key"
AZURE_OPENAI_DEPLOYMENT="gpt-5-mini"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"

# Azure OpenAI Configuration (Embeddings - separate resource to save memory)
AZURE_EMBEDDING_ENDPOINT="https://embeding.openai.azure.com/"
AZURE_EMBEDDING_API_KEY="replace-with-your-embedding-api-key"
AZURE_EMBEDDING_DEPLOYMENT="text-embedding-3-small"
AZURE_EMBEDDING_API_VERSION="2024-02-15-preview"

# Admin Credentials (for initial setup)
ADMIN_EMAIL="admin@daad.de"
ADMIN_PASSWORD="replace-with-secure-password"

# Email Settings (SMTP)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
